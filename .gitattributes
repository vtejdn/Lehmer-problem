# LF line endings for text files across platforms; binary bytes stay untouched.
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
*.md text eol=lf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.md.in text eol=lf
*.py text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.ps1 text eol=lf
*.pdf binary
# Use LF by default for JSON and JSONL.
*.json text eol=lf
*.jsonl text eol=lf

# Preserve the original serialization of fixed reports retained from reviewed runs.
mathematics/computations/programs/Yin_J_G0138/inputs/**/*.json -text !eol whitespace=cr-at-eol
mathematics/computations/programs/Yin_J_G0168/inputs/**/*.csv -text !eol whitespace=cr-at-eol
